{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artificial-brain-labs.org/crp/v0.2/cognitive-event.schema.json",
  "title": "GRI Cognitive Event CRP v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "crp_version",
    "interaction_id",
    "timestamp",
    "source",
    "state_context",
    "observation",
    "interpretation",
    "evidence",
    "inferences",
    "uncertainty",
    "proposal",
    "governance",
    "provenance"
  ],
  "properties": {
    "crp_version": {
      "const": "0.2"
    },
    "interaction_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "state_context": {
      "$ref": "#/$defs/state_context"
    },
    "observation": {
      "$ref": "#/$defs/observation"
    },
    "interpretation": {
      "$ref": "#/$defs/interpretation"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inference"
      }
    },
    "uncertainty": {
      "$ref": "#/$defs/uncertainty"
    },
    "proposal": {
      "$ref": "#/$defs/proposal"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "transition_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/transition_reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "identifier"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "user",
            "system",
            "environment",
            "agent",
            "sensor",
            "external_document"
          ]
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "state_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "state_version"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "minLength": 1
        },
        "state_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_input",
        "status",
        "facts"
      ],
      "properties": {
        "raw_input": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "explicit",
            "observed",
            "unknown"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "claim",
        "status"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "explicit",
            "observed"
          ]
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "events",
        "relationships"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "type",
        "name"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "type",
        "actor",
        "target"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "target",
        "type"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "type",
        "claim",
        "source_ref"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "observation",
            "interpretation",
            "external_source",
            "system_state",
            "historical_transition"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inference_id",
        "claim",
        "basis",
        "status"
      ],
      "properties": {
        "inference_id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "hypothesis",
            "possible",
            "probable"
          ]
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknowns",
        "ambiguities"
      ],
      "properties": {
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "target_type",
        "target_id",
        "operation",
        "evidence",
        "rationale",
        "status"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "target_type": {
          "type": "string",
          "enum": [
            "belief",
            "concept",
            "relationship",
            "goal",
            "dimension",
            "learning_state"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "create",
            "modify",
            "reinforce",
            "weaken",
            "remove"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "withdrawn",
            "superseded"
          ]
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "constraints_checked",
        "reason",
        "version"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "requires_review"
          ]
        },
        "constraints_checked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transition_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "outcome"
      ],
      "properties": {
        "transition_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": [
            "committed",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_interaction",
        "interpreter",
        "schema_version"
      ],
      "properties": {
        "source_interaction": {
          "type": "string",
          "minLength": 1
        },
        "interpreter": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_component": {
          "type": [
            "string",
            "null"
          ]
        },
        "originating_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "type": "string",
          "const": "0.2"
        }
      }
    }
  }
}
